# Copy to .env and fill in real values. Never commit a filled-in .env.
#
# The application fails to start in production if any required value is missing —
# it will not fall back to a development default.

# --- Required ---------------------------------------------------------------

# PostgreSQL connection string for the production database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/avenue_reos?schema=public"

# Secret used to key session and password-reset token fingerprints.
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every active session and reset token.
SESSION_SECRET=""

# Tenant this deployment serves. Sessions belonging to any other tenant are rejected.
NEXT_PUBLIC_AVENUE_TENANT_ID="00000000-0000-0000-0000-000000000001"

# --- Session and cookies ----------------------------------------------------

# Idle timeout: a session expires this many hours after its last request.
SESSION_TTL_HOURS="12"

# Hard ceiling: a session cannot outlive this many hours regardless of activity.
SESSION_ABSOLUTE_TTL_HOURS="720"

# Set to false ONLY when serving over plain HTTP in local development.
# Leaving this false in production transmits session cookies in the clear.
COOKIE_SECURE="true"

# --- Credentials policy -----------------------------------------------------

PASSWORD_MIN_LENGTH="12"
LOGIN_MAX_ATTEMPTS="8"
LOGIN_ATTEMPT_WINDOW_MINUTES="15"

# --- Data service container (docker-compose.yml) ----------------------------

# These configure the bundled PostgreSQL container. They must agree with DATABASE_URL.
POSTGRES_USER="avenue_admin"
POSTGRES_PASSWORD=""
POSTGRES_DB="avenue_reos"

# --- Data service -----------------------------------------------------------

DATABASE_POOL_SIZE="10"
DATABASE_POOL_TIMEOUT_SECONDS="20"
DATABASE_CONNECT_TIMEOUT_SECONDS="10"

# Allows route handlers to issue CREATE TABLE IF NOT EXISTS at request time.
# Always false in production: migrations own the schema and the application database
# role should not hold DDL rights. Ignored (treated as true) outside production.
ALLOW_RUNTIME_DDL="false"
