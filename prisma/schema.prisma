model SystemUser {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  fullName          String               @map("full_name") @db.VarChar(255)
  email             String               @unique @db.VarChar(255)
  passwordHash      String               @map("password_hash") @db.VarChar(255)
  department        String               @db.VarChar(100)
  designation       String               @db.VarChar(100)
  siteLocation      String               @default("Nashik Corporate Office") @map("site_location") @db.VarChar(255)
  mfaEnabled        Boolean              @default(false) @map("mfa_enabled")
  status            String               @default("PENDING_APPROVAL") @db.VarChar(50)
  role              String               @default("Site Engineer") @db.VarChar(100)
  lastActive        DateTime             @default(now()) @map("last_active") @db.Timestamptz
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  mustResetPassword Boolean              @default(false) @map("must_reset_password")
  failedLoginCount  Int                  @default(0) @map("failed_login_count")
  lockedUntil       DateTime?            @map("locked_until") @db.Timestamptz
  passwordChangedAt DateTime?            @map("password_changed_at") @db.Timestamptz
  sessions          SystemSession[]
  resetTokens       PasswordResetToken[]

  @@unique([tenantId, email], name: "uq_system_users_tenant_email")
  @@index([tenantId, status])
  @@map("system_users")
}

model SystemSession {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  tokenHash         String     @unique @map("token_hash") @db.Char(64)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt        DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz
  expiresAt         DateTime   @map("expires_at") @db.Timestamptz
  absoluteExpiresAt DateTime   @map("absolute_expires_at") @db.Timestamptz
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz
  userAgent         String     @default("unknown") @map("user_agent") @db.VarChar(255)
  ipAddress         String     @default("unknown") @map("ip_address") @db.VarChar(100)
  user              SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("system_sessions")
}

model PasswordResetToken {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  tokenHash   String     @unique @map("token_hash") @db.Char(64)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz
  consumedAt  DateTime?  @map("consumed_at") @db.Timestamptz
  requestedIp String     @default("unknown") @map("requested_ip") @db.VarChar(100)
  user        SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuthLoginAttempt {
  id          BigInt   @id @default(autoincrement())
  identifier  String   @db.VarChar(255)
  ipAddress   String   @default("unknown") @map("ip_address") @db.VarChar(100)
  succeeded   Boolean  @default(false)
  attemptedAt DateTime @default(now()) @map("attempted_at") @db.Timestamptz

  @@index([identifier, attemptedAt(sort: Desc)])
  @@index([ipAddress, attemptedAt(sort: Desc)])
  @@map("auth_login_attempts")
}
